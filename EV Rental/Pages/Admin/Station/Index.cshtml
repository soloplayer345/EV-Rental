@page
@model EV_Rental.Pages.Admin.Station.IndexModel
@{
    ViewData["Title"] = "Quản lý Trạm";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<!-- Page Header -->
<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="fas fa-charging-station me-2"></i>Quản lý Trạm</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Admin/Dashboard">Trang chủ</a></li>
                <li class="breadcrumb-item active">Quản lý Trạm</li>
            </ol>
        </nav>
    </div>
    <div>
        <a href="/Admin/Station/Create" class="btn btn-admin-primary">
            <i class="fas fa-plus me-2"></i>Thêm trạm mới
        </a>
    </div>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search and Filter Section -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-7">
                <label for="search" class="form-label">Tìm kiếm trạm</label>
                <input type="text" class="form-control" id="search" name="search" 
                       placeholder="Tên trạm, địa chỉ, tỉnh/thành phố..." value="@Model.SearchQuery">
            </div>
            <div class="col-md-3">
                <label for="state" class="form-label">Tỉnh/Thành phố</label>
                <input type="text" class="form-control" id="state" name="state" 
                       placeholder="VD: Hà Nội, Hồ Chí Minh..." value="@Model.FilterState">
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-admin-primary flex-grow-1">
                    <i class="fas fa-search me-1"></i>Tìm kiếm
                </button>
                <a href="/Admin/Station/Index" class="btn btn-outline-secondary">
                    <i class="fas fa-redo me-1"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Stations Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-list me-2"></i>Danh sách trạm (@Model.Stations.Count)</h5>
    </div>
    <div class="table-responsive">
        @if (Model.Stations.Count > 0)
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên trạm</th>
                        <th>Địa chỉ</th>
                        <th>Tỉnh/Thành phố</th>
                        <th>Số xe</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var station in Model.Stations)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark">@station.Id</span>
                            </td>
                            <td>
                                <strong>@station.Name</strong>
                            </td>
                            <td>
                                <small class="text-muted">@station.Address</small>
                            </td>
                            <td>
                                <span class="badge bg-info text-white">@station.State</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark">@station.Vehicles.Count</span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="/Admin/Station/Edit/@station.Id" class="btn btn-outline-primary" 
                                       title="Chỉnh sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" 
                                            data-bs-toggle="modal" data-bs-target="#deleteModal_@station.Id"
                                            title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>

                                <!-- Delete Confirmation Modal -->
                                <div class="modal fade" id="deleteModal_@station.Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Xác nhận xóa</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p>Bạn có chắc chắn muốn xóa trạm <strong>@station.Name</strong> không?</p>
                                                <p class="text-muted"><small>Thao tác này không thể hoàn tác.</small></p>
                                                @if (station.Vehicles.Count > 0)
                                                {
                                                    <div class="alert alert-warning mb-0">
                                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                                        <strong>Cảnh báo:</strong> Trạm này đang có @station.Vehicles.Count chiếc xe. Bạn vẫn muốn xóa?
                                                    </div>
                                                }
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <form method="post" asp-page-handler="Delete" style="display: inline;">
                                                    <input type="hidden" name="id" value="@station.Id">
                                                    <button type="submit" class="btn btn-danger">Xóa</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="table-empty-state p-5 text-center">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted">
                    @if (!string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.FilterState))
                    {
                        <span>Không tìm thấy trạm nào phù hợp với điều kiện tìm kiếm.</span>
                    }
                    else
                    {
                        <span>Chưa có trạm nào được thêm vào hệ thống.</span>
                    }
                </p>
                @if (string.IsNullOrEmpty(Model.SearchQuery) && string.IsNullOrEmpty(Model.FilterState))
                {
                    <a href="/Admin/Station/Create" class="btn btn-admin-primary mt-3">
                        <i class="fas fa-plus me-2"></i>Thêm trạm mới
                    </a>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Auto dismiss alerts after 5 seconds
        document.querySelectorAll('.alert').forEach(alert => {
            setTimeout(() => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            }, 5000);
        });
    </script>
}
