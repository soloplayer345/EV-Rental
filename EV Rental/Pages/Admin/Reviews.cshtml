@page
@model EV_Rental.Pages.Admin.ReviewsModel
@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Báo Cáo Đánh Giá";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-star-fill text-warning me-2"></i>Báo Cáo Đánh Giá</h2>
            <p class="text-muted mb-0">Quản lý và theo dõi đánh giá từ khách hàng</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-1 small">Tổng Đánh Giá</p>
                            <h3 class="mb-0 fw-bold">@Model.Statistics.TotalReviews</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded">
                            <i class="bi bi-chat-text text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-1 small">Điểm Trung Bình</p>
                            <h3 class="mb-0 fw-bold">
                                @Model.Statistics.AverageRating.ToString("F1")
                                <i class="bi bi-star-fill text-warning fs-5"></i>
                            </h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded">
                            <i class="bi bi-star text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-1 small">5 Sao</p>
                            <h3 class="mb-0 fw-bold">@Model.Statistics.FiveStarCount</h3>
                            <small class="text-success">@Model.Statistics.FiveStarPercentage.ToString("F1")%</small>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded">
                            <i class="bi bi-emoji-smile text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-1 small">1-2 Sao</p>
                            <h3 class="mb-0 fw-bold">@(Model.Statistics.OneStarCount + Model.Statistics.TwoStarCount)</h3>
                            <small class="text-danger">@((Model.Statistics.OneStarPercentage + Model.Statistics.TwoStarPercentage).ToString("F1"))%</small>
                        </div>
                        <div class="bg-danger bg-opacity-10 p-3 rounded">
                            <i class="bi bi-emoji-frown text-danger fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Rating Distribution -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title mb-4"><i class="bi bi-bar-chart-fill me-2"></i>Phân Bố Đánh Giá</h5>
            <div class="rating-distribution">
                @for (int i = 5; i >= 1; i--)
                {
                    var count = Model.Statistics.RatingDistribution.GetValueOrDefault(i, 0);
                    var percentage = Model.Statistics.TotalReviews > 0 
                        ? (count / (double)Model.Statistics.TotalReviews * 100) 
                        : 0;
                    
                    <div class="mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <span class="me-2" style="min-width: 50px;">@i <i class="bi bi-star-fill text-warning"></i></span>
                            <div class="progress flex-grow-1" style="height: 25px;">
                                <div class="progress-bar bg-warning" 
                                     role="progressbar" 
                                     style="width: @percentage.ToString("F1")%;" 
                                     aria-valuenow="@percentage" 
                                     aria-valuemin="0" 
                                     aria-valuemax="100">
                                </div>
                            </div>
                            <span class="ms-3 text-muted" style="min-width: 80px;">@count (@percentage.ToString("F1")%)</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Filter and Search -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Tìm kiếm</label>
                    <input type="text" class="form-control" name="searchTerm" 
                           value="@Model.SearchTerm" placeholder="Tìm theo tên xe, khách hàng...">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Lọc theo đánh giá</label>
                    <select class="form-select" name="ratingFilter">
                        <option value="">Tất cả</option>
                        <option value="5" selected="@(Model.RatingFilter == 5)">5 sao</option>
                        <option value="4" selected="@(Model.RatingFilter == 4)">4 sao</option>
                        <option value="3" selected="@(Model.RatingFilter == 3)">3 sao</option>
                        <option value="2" selected="@(Model.RatingFilter == 2)">2 sao</option>
                        <option value="1" selected="@(Model.RatingFilter == 1)">1 sao</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Sắp xếp</label>
                    <select class="form-select" name="sortBy">
                        <option value="newest" selected="@(Model.SortBy == "newest")">Mới nhất</option>
                        <option value="oldest" selected="@(Model.SortBy == "oldest")">Cũ nhất</option>
                        <option value="highest" selected="@(Model.SortBy == "highest")">Đánh giá cao nhất</option>
                        <option value="lowest" selected="@(Model.SortBy == "lowest")">Đánh giá thấp nhất</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i>Lọc
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Reviews List -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <h5 class="card-title mb-4">
                <i class="bi bi-list-ul me-2"></i>Danh Sách Đánh Giá
                <span class="badge bg-primary ms-2">@Model.FilteredReviews.Count()</span>
            </h5>

            @if (!Model.FilteredReviews.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted"></i>
                    <p class="text-muted mt-3">Không có đánh giá nào</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Xe</th>
                                <th>Khách Hàng</th>
                                <th>Đánh Giá</th>
                                <th>Nhận Xét</th>
                                <th>Ngày Đánh Giá</th>
                                <th>Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var review in Model.FilteredReviews)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@review.VehicleImageUrl" 
                                                 alt="@review.VehicleName" 
                                                 class="rounded me-3"
                                                 style="width: 60px; height: 60px; object-fit: cover;"
                                                 onerror="this.src='/images/default-vehicle.png'">
                                            <div>
                                                <div class="fw-semibold">@review.VehicleName</div>
                                                <small class="text-muted">@review.VehiclePlateNumber</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            <div class="fw-semibold">@review.RenterName</div>
                                            <small class="text-muted">@review.RenterEmail</small>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="badge @GetRatingBadgeClass(review.Rating) fs-6">
                                                @review.Rating <i class="bi bi-star-fill"></i>
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="max-width: 300px;">
                                            @if (!string.IsNullOrEmpty(review.Comment))
                                            {
                                                <p class="mb-0 text-truncate" title="@review.Comment">
                                                    @review.Comment
                                                </p>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">Không có nhận xét</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <small>@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                    </td>
                                    <td>
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-primary" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#reviewDetailModal"
                                                onclick="showReviewDetail(@review.Id, '@review.VehicleName', '@review.VehiclePlateNumber', '@review.RenterName', '@review.RenterEmail', @review.Rating, '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(review.Comment))', '@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")', '@review.VehicleImageUrl')">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Review Detail Modal -->
<div class="modal fade" id="reviewDetailModal" tabindex="-1" aria-labelledby="reviewDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="reviewDetailModalLabel">
                    <i class="bi bi-star-fill text-warning me-2"></i>Chi Tiết Đánh Giá
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-4 text-center mb-3">
                        <img id="modalVehicleImage" src="" alt="" class="img-fluid rounded mb-3" style="max-height: 200px;">
                        <h6 id="modalVehicleName" class="fw-bold"></h6>
                        <p id="modalVehiclePlate" class="text-muted mb-0"></p>
                    </div>
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Khách Hàng</label>
                            <p id="modalRenterName" class="mb-0"></p>
                            <small id="modalRenterEmail" class="text-muted"></small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Đánh Giá</label>
                            <div>
                                <span id="modalRating" class="badge bg-warning fs-5"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nhận Xét</label>
                            <p id="modalComment" class="text-muted"></p>
                        </div>
                        <div>
                            <label class="form-label fw-semibold">Ngày Đánh Giá</label>
                            <p id="modalCreatedAt" class="text-muted mb-0"></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showReviewDetail(id, vehicleName, vehiclePlate, renterName, renterEmail, rating, comment, createdAt, vehicleImage) {
            document.getElementById('modalVehicleImage').src = vehicleImage || '/images/default-vehicle.png';
            document.getElementById('modalVehicleName').textContent = vehicleName;
            document.getElementById('modalVehiclePlate').textContent = vehiclePlate;
            document.getElementById('modalRenterName').textContent = renterName;
            document.getElementById('modalRenterEmail').textContent = renterEmail;
            document.getElementById('modalRating').textContent = rating + ' ★';
            document.getElementById('modalComment').textContent = comment || 'Không có nhận xét';
            document.getElementById('modalCreatedAt').textContent = createdAt;
        }
    </script>
}

@functions {
    private string GetRatingBadgeClass(int rating)
    {
        return rating switch
        {
            5 => "bg-success",
            4 => "bg-info",
            3 => "bg-warning",
            2 => "bg-orange text-dark",
            1 => "bg-danger",
            _ => "bg-secondary"
        };
    }
}

