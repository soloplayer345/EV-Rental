@page
@model EV_Rental.Pages.Admin.RentalRecord.IndexModel
@{
    ViewData["Title"] = "Quản lý Đơn Thuê";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<!-- Page Header -->
<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="fas fa-clipboard-list me-2"></i>Quản lý Đơn Thuê</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Admin/Dashboard">Trang chủ</a></li>
                <li class="breadcrumb-item active">Quản lý Đơn Thuê</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search and Filter Section -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label for="search" class="form-label">Tìm kiếm</label>
                <input type="text" class="form-control" id="search" name="search" 
                       placeholder="Tên khách, email, biển số xe..." value="@Model.SearchQuery">
            </div>
            <div class="col-md-2">
                <label for="status" class="form-label">Trạng thái</label>
                <select class="form-select" id="status" name="status">
                    <option value="">Tất cả</option>
                    <option value="Pending" selected="@(Model.FilterStatus == "Pending")">Chờ thanh toán</option>
                    <option value="Confirmed" selected="@(Model.FilterStatus == "Confirmed")">Đã thanh toán</option>
                    <option value="Active" selected="@(Model.FilterStatus == "Active")">Đang thuê</option>
                    <option value="Completed" selected="@(Model.FilterStatus == "Completed")">Hoàn thành</option>
                    <option value="Cancelled" selected="@(Model.FilterStatus == "Cancelled")">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="startDate" class="form-label">Từ ngày</label>
                <input type="date" class="form-control" id="startDate" name="startDate" value="@Model.StartDate">
            </div>
            <div class="col-md-2">
                <label for="endDate" class="form-label">Đến ngày</label>
                <input type="date" class="form-control" id="endDate" name="endDate" value="@Model.EndDate">
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-admin-primary flex-grow-1">
                    <i class="fas fa-search me-1"></i>Tìm kiếm
                </button>
                <a href="/Admin/RentalRecord/Index" class="btn btn-outline-secondary">
                    <i class="fas fa-redo me-1"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Rental Records Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-list me-2"></i>Danh sách đơn thuê (@Model.RentalRecords.Count)</h5>
    </div>
    <div class="table-responsive">
        @if (Model.RentalRecords.Count > 0)
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Khách hàng</th>
                        <th>Xe</th>
                        <th>Thời gian thuê</th>
                        <th>Trạm nhận/Trạm trả</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.RentalRecords)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark">@record.Id</span>
                            </td>
                            <td>
                                <div>
                                    <strong>@record.Renter?.FullName</strong>
                                    <br>
                                    <small class="text-muted">@record.Renter?.Email</small>
                                </div>
                            </td>
                            <td>
                                <div>
                                    <strong>@record.Vehicle?.Name</strong>
                                    <br>
                                    <small class="text-muted">@record.Vehicle?.PlateNumber</small>
                                </div>
                            </td>
                            <td>
                                <small>
                                    <strong>Từ:</strong> @record.StartTime?.ToString("dd/MM/yyyy HH:mm")<br>
                                    <strong>Dự kiến:</strong> @record.ExpectedEndTime?.ToString("dd/MM/yyyy HH:mm")<br>
                                    @if (record.ActualEndTime.HasValue)
                                    {
                                        <strong>Thực tế:</strong> @record.ActualEndTime.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                </small>
                            </td>
                            <td>
                                <small>
                                    <strong>Nhận:</strong> @record.PickupStation?.Name<br>
                                    @if (record.ReturnStation != null)
                                    {
                                        <strong>Trả:</strong> @record.ReturnStation.Name
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa trả</span>
                                    }
                                </small>
                            </td>
                            <td>
                                <strong>₫@record.TotalPrice.ToString("N0")</strong>
                            </td>
                            <td>
                                @{
                                    var statusClass = record.Status switch
                                    {
                                        DataAccessLayer.Enums.RentalRecordStatus.Pending => "badge-pending",
                                        DataAccessLayer.Enums.RentalRecordStatus.Confirmed => "badge-info",
                                        DataAccessLayer.Enums.RentalRecordStatus.Active => "badge-warning",
                                        DataAccessLayer.Enums.RentalRecordStatus.Completed => "badge-active",
                                        DataAccessLayer.Enums.RentalRecordStatus.Cancelled => "badge-inactive",
                                        _ => "badge-secondary"
                                    };
                                    var statusText = record.Status switch
                                    {
                                        DataAccessLayer.Enums.RentalRecordStatus.Pending => "Chờ thanh toán",
                                        DataAccessLayer.Enums.RentalRecordStatus.Confirmed => "Đã thanh toán",
                                        DataAccessLayer.Enums.RentalRecordStatus.Active => "Đang thuê",
                                        DataAccessLayer.Enums.RentalRecordStatus.Completed => "Hoàn thành",
                                        DataAccessLayer.Enums.RentalRecordStatus.Cancelled => "Đã hủy",
                                        _ => record.Status.ToString()
                                    };
                                }
                                <span class="badge badge-custom @statusClass">@statusText</span>
                            </td>
                            <td>
                                <a href="/Admin/RentalRecord/Detail/@record.Id" class="btn btn-sm btn-outline-primary" 
                                   title="Xem chi tiết">
                                    <i class="fas fa-eye"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="table-empty-state p-5 text-center">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted">
                    @if (!string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.FilterStatus) || !string.IsNullOrEmpty(Model.StartDate) || !string.IsNullOrEmpty(Model.EndDate))
                    {
                        <span>Không tìm thấy đơn thuê nào phù hợp với điều kiện tìm kiếm.</span>
                    }
                    else
                    {
                        <span>Chưa có đơn thuê nào trong hệ thống.</span>
                    }
                </p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Auto dismiss alerts after 5 seconds
        document.querySelectorAll('.alert').forEach(alert => {
            setTimeout(() => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            }, 5000);
        });
    </script>
}

