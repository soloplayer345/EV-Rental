@page
@model StaffIndexModel
@{
    ViewData["Title"] = "Qu?n lý xe di?n - Nhân viên";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Qu?n lý xe di?n</h1>
            <p class="text-muted">Qu?n lý danh sách xe di?n trong h? th?ng</p>
        </div>
        <a asp-page="/Staff/CreateVehicle" class="btn btn-success btn-lg shadow-sm">
            <i class="bi bi-plus-circle"></i> Thêm xe m?i
        </a>
    </div>

    <!-- Search & Filter Section -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Tên xe</label>
                    <input type="text" name="name" placeholder="Nh?p tên xe..." class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold">Hãng xe</label>
                    <input type="text" name="brand" placeholder="Hãng xe..." class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold">Tr?ng thái</label>
                    <select name="status" class="form-select">
                        <option value="">-- T?t c? tr?ng thái --</option>
                        <option value="Available">Chua cho thuê</option>
                        <option value="Rented">Ðã cho thuê</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold">&nbsp;</label>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Tìm ki?m
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Vehicles Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-table"></i> Danh sách xe</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Vehicles == null || !Model.Vehicles.Any())
            {
                <div class="alert alert-info m-3" role="alert">
                    <i class="bi bi-info-circle"></i> Không có xe nào phù h?p.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>?nh</th>
                                <th>Tên xe</th>
                                <th>Hãng</th>
                                <th>Bi?n s?</th>
                                <th>Lo?i xe</th>
                                <th>Giá/Gi?</th>
                                <th>Giá/Ngày</th>
                                <th>Tr?ng thái</th>
                                <th class="text-center" style="width: 150px;">Hành d?ng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vehicle in Model.Vehicles)
                            {
                                <tr>
                                    <td>
                                        <img src="@vehicle.ImageUrl" alt="@vehicle.Name" class="vehicle-thumbnail" />
                                    </td>
                                    <td class="fw-bold">@vehicle.Name</td>
                                    <td>@vehicle.Brand</td>
                                    <td>
                                        <span class="badge bg-secondary">@vehicle.PlateNumber</span>
                                    </td>
                                    <td>@vehicle.Model</td>
                                    <td>@vehicle.PricePerHour:N0 ?</td>
                                    <td>@vehicle.PricePerDay:N0 ?</td>
                                    <td>
                                        @if (vehicle.Status == DataAccessLayer.Enums.VehicleStatus.Available)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> S?n sàng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning"><i class="bi bi-exclamation-circle"></i> Ðã cho thuê</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a href="/Staff/UpdateVehicle?id=@vehicle.Id" class="btn btn-sm btn-warning" title="S?a">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-danger" onclick="deleteVehicle(@vehicle.Id)" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .vehicle-thumbnail {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 4px;
    }

    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }

    .btn-group .btn {
        border-radius: 0.375rem;
        margin: 0 2px;
    }
</style>

@section Scripts {
    <script>
        async function deleteVehicle(id) {
            if (!confirm("B?n có ch?c mu?n xóa xe này không?")) return;

            try {
                const res = await fetch(`/Staff/DeleteVehicle?id=${id}`, { method: 'POST' });
                if (res.ok) {
                    alert("Ðã xóa xe thành công!");
                    location.reload();
                } else {
                    const error = await res.text();
                    alert("L?i khi xóa xe: " + error);
                }
            } catch (error) {
                alert("L?i: " + error.message);
            }
        }
    </script>
}


