@page
@model StaffIndexModel
@{
    ViewData["Title"] = "Quản lý xe điện - Nhân viên";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Quản lý xe điện</h2>
        <a asp-page="/Vehicles/Create" class="btn btn-success btn-lg shadow-sm">
            <i class="bi bi-plus-circle"></i> Thêm xe mới
        </a>
    </div>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <h2 class="hero-title">Tìm Xe Điện Hoàn Hảo Của Bạn</h2>
            <p class="hero-subtitle">Chọn, thuê và lái xe điện từ các trạm gần bạn</p>

            <form method="get" asp-page="/Vehicles/Index" class="search-form">
                <div class="search-fields">
                    <input type="text" name="name" placeholder="Nhập tên xe..." class="search-input" />

                    <input type="text" name="brand" placeholder="Hãng xe..." class="search-input" />

                    <select name="status" class="search-select">
                        <option value="">-- Trạng thái --</option>
                        <option value="Available">Chưa cho thuê</option>
                        <option value="Rented">Đã cho thuê</option>
                    </select>

                    <button class="btn-outline" onclick="document.getElementById('vehicles-section').scrollIntoView({behavior: 'smooth'})">
                        Xem tất cả xe
                    </button>
                </div>
            </form>

            <button class="btn-primary" onclick="document.getElementById('vehicles-section').scrollIntoView({behavior: 'smooth'})">Tìm Xe Ngay</button>
        </div>
    </section>

    <!-- Danh sách xe -->
    <section id="vehicles-section" class="vehicles-section">
        <div class="container">
            <h2>Danh sách xe</h2>

            @if (Model.Vehicles == null || !Model.Vehicles.Any())
            {
                <p class="text-center text-muted">Không có xe nào phù hợp.</p>
            }
            else
            {
                <div class="vehicle-grid">
                    @foreach (var vehicle in Model.Vehicles)
                    {
                        <div class="vehicle-card">
                            <img src="@vehicle.imageUrl" alt="@vehicle.name" class="vehicle-image" />
                            <div class="vehicle-info">
                                <h3>@vehicle.name</h3>
                                <p><b>Hãng:</b> @vehicle.brand</p>
                                <p><b>Trạng thái:</b>
                                    @if (vehicle.status == DataAccessLayer.Enums.VehicleStatus.Available)
                                    {
                                        <span class="badge bg-success">Chưa cho thuê</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Đã cho thuê</span>
                                    }
                                </p>

                                <div class="btn-group">
                                    <a href="/Vehicles/Details?id=@vehicle.Id" class="btn btn-outline-info btn-sm">Chi tiết</a>
                                    <a href="/Vehicles/Edit?id=@vehicle.Id" class="btn btn-outline-warning btn-sm">Sửa</a>
                                    <button class="btn btn-outline-danger btn-sm"
                                            onclick="deleteVehicle(@vehicle.Id)">
                                        Xóa
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    @section Scripts {
        <script>
            async function deleteVehicle(id) {
                if (!confirm("Bạn có chắc muốn xóa xe này không?")) return;

                const res = await fetch(`/Vehicles/Delete?id=${id}`, { method: 'POST' });
                if (res.ok) {
                    alert("Đã xóa xe thành công!");
                    location.reload();
                } else {
                    alert("Lỗi khi xóa xe!");
                }
            }
        </script>
    }
</div>
