@page "{id:int}"
@model EV_Rental.Pages.Staff.RentalRecord.DetailModel
@{
    ViewData["Title"] = "Chi tiết Đơn Thuê";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="fas fa-receipt me-2"></i>Chi tiết Đơn Thuê #@Model.RentalRecord.Id</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Staff/Dashboard">Trang chủ</a></li>
                <li class="breadcrumb-item active">Chi tiết Đơn</li>
            </ol>
        </nav>
    </div>
    <div>
        <a href="/Staff/Dashboard" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Quay lại
        </a>
    </div>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- Main Content -->
    <div class="col-lg-8">
        <!-- Rental Information -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Thông tin Đơn Thuê</h5>
                @{
                    var statusClass = Model.RentalRecord.Status switch
                    {
                        DataAccessLayer.Enums.RentalRecordStatus.Pending => "badge-pending",
                        DataAccessLayer.Enums.RentalRecordStatus.Confirmed => "badge-info",
                        DataAccessLayer.Enums.RentalRecordStatus.Active => "badge-warning",
                        DataAccessLayer.Enums.RentalRecordStatus.Completed => "badge-active",
                        DataAccessLayer.Enums.RentalRecordStatus.Cancelled => "badge-inactive",
                        _ => "badge-secondary"
                    };
                    var statusText = Model.RentalRecord.Status switch
                    {
                        DataAccessLayer.Enums.RentalRecordStatus.Pending => "Chờ thanh toán",
                        DataAccessLayer.Enums.RentalRecordStatus.Confirmed => "Đã thanh toán",
                        DataAccessLayer.Enums.RentalRecordStatus.Active => "Đang thuê",
                        DataAccessLayer.Enums.RentalRecordStatus.Completed => "Hoàn thành",
                        DataAccessLayer.Enums.RentalRecordStatus.Cancelled => "Đã hủy",
                        _ => Model.RentalRecord.Status.ToString()
                    };
                }
                <span class="badge badge-custom @statusClass">@statusText</span>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted">Mã Đơn</label>
                        <p class="fs-5">
                            <strong>#@Model.RentalRecord.Id</strong>
                            <code class="ms-2">@Model.RentalRecord.OtpCode</code>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">Ngày Tạo</label>
                        <p class="fs-5">
                            <strong>@Model.RentalRecord.CreateDate.ToString("dd/MM/yyyy HH:mm")</strong>
                        </p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted">Thời Gian Thuê</label>
                        <p>
                            <strong>Từ:</strong> @Model.RentalRecord.StartTime?.ToString("dd/MM/yyyy HH:mm")<br>
                            <strong>Dự kiến:</strong> @Model.RentalRecord.ExpectedEndTime?.ToString("dd/MM/yyyy HH:mm")<br>
                            @if (Model.RentalRecord.ActualEndTime.HasValue)
                            {
                                <strong>Thực tế:</strong> @Model.RentalRecord.ActualEndTime.Value.ToString("dd/MM/yyyy HH:mm")
                            }
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">Thời Gian Thuê (Tính)</label>
                        @{
                            var rentalDays = (Model.RentalRecord.ExpectedEndTime?.Subtract(Model.RentalRecord.StartTime ?? DateTime.Now).TotalDays ?? 0);
                            var actualDays = Model.RentalRecord.ActualEndTime.HasValue 
                                ? (Model.RentalRecord.ActualEndTime.Value.Subtract(Model.RentalRecord.StartTime ?? DateTime.Now).TotalDays) 
                                : rentalDays;
                        }
                        <p>
                            <strong>Dự kiến:</strong> @Math.Ceiling((double)rentalDays)<text> ngày</text><br>
                            @if (Model.RentalRecord.ActualEndTime.HasValue)
                            {
                                <strong>Thực tế:</strong> @Math.Ceiling((double)actualDays)<text> ngày</text>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Customer Information -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-user me-2"></i>Thông tin Khách Hàng</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label text-muted">Tên Khách</label>
                        <p class="fs-5"><strong>@Model.RentalRecord.Renter?.FullName</strong></p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">Email</label>
                        <p class="fs-5"><strong>@Model.RentalRecord.Renter?.Email</strong></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Vehicle Information -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-car me-2"></i>Thông tin Xe</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label text-muted">Tên Xe</label>
                        <p class="fs-5"><strong>@Model.RentalRecord.Vehicle?.Name</strong></p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">Biển Số</label>
                        <p class="fs-5"><strong>@Model.RentalRecord.Vehicle?.PlateNumber</strong></p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label text-muted">Loại Xe</label>
                        <p><strong>@Model.RentalRecord.Vehicle?.VehicleType</strong></p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">Dòng Xe</label>
                        <p><strong>@Model.RentalRecord.Vehicle?.Model</strong></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Station Information -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-map-marker-alt me-2"></i>Thông tin Trạm</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label text-muted">Trạm Nhận Xe</label>
                        <p>
                            <strong>@Model.RentalRecord.PickupStation?.Name</strong><br>
                            <small class="text-muted">@Model.RentalRecord.PickupStation?.Address</small>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">Trạm Trả Xe</label>
                        @if (Model.RentalRecord.ReturnStation != null)
                        {
                            <p>
                                <strong>@Model.RentalRecord.ReturnStation.Name</strong><br>
                                <small class="text-muted">@Model.RentalRecord.ReturnStation.Address</small>
                            </p>
                        }
                        else
                        {
                            <p><span class="text-muted">Chưa trả xe</span></p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Inspection Problems -->
        @if (Model.RentalRecord.InspectionProblems.Any())
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-tools me-2"></i>Vấn Đề Kiểm Tra</h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        @foreach (var problem in Model.RentalRecord.InspectionProblems)
                        {
                            <div class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@problem.IncidentType</h6>
                                    <span class="badge bg-danger">₫@problem.PenaltyAmount.ToString("N0")</span>
                                </div>
                                <p class="mb-1">@problem.Description</p>
                                <small class="text-muted">Phát hiện: @problem.CreateDate.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Price Summary -->
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-calculator me-2"></i>Chi Tiết Giá</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span>Giá Cơ Bản:</span>
                    <strong>₫@Model.RentalRecord.BasePrice.ToString("N0")</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Phí Cọc:</span>
                    <strong>₫@Model.RentalRecord.DepositFee.ToString("N0")</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Phí Giữ Chỗ:</span>
                    <strong>₫@Model.RentalRecord.ReservationFee.ToString("N0")</strong>
                </div>
                @if (Model.RentalRecord.ExtraFees > 0)
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span>Phí Phát Sinh:</span>
                        <strong class="text-danger">₫@Model.RentalRecord.ExtraFees.ToString("N0")</strong>
                    </div>
                }
                @if (Model.RentalRecord.Discount > 0)
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span>Giảm Giá:</span>
                        <strong class="text-success">-₫@Model.RentalRecord.Discount.ToString("N0")</strong>
                    </div>
                }
                <hr>
                <div class="d-flex justify-content-between fs-5">
                    <span>Tổng Tiền:</span>
                    <strong class="text-primary">₫@Model.RentalRecord.TotalPrice.ToString("N0")</strong>
                </div>
            </div>
        </div>

        <!-- Payments -->
        @if (Model.RentalRecord.Payments.Any())
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-money-bill-wave me-2"></i>Thanh Toán (@Model.RentalRecord.Payments.Count)</h5>
                </div>
                <div class="card-body">
                    @foreach (var payment in Model.RentalRecord.Payments)
                    {
                        <div class="mb-3 pb-3 border-bottom">
                            <div class="d-flex justify-content-between">
                                <strong>₫@payment.Amount.ToString("N0")</strong>
                                <small class="badge bg-success">@payment.Method</small>
                            </div>
                            <small class="text-muted">@payment.PaidAt?.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Auto dismiss alerts after 5 seconds
        document.querySelectorAll('.alert').forEach(alert => {
            setTimeout(() => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            }, 5000);
        });
    </script>
}
