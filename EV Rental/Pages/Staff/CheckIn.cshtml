@page
@model EV_Rental.Pages.Staff.CheckInModel
@{
    ViewData["Title"] = "Vehicle Check-In";
}

<!DOCTYPE html>
<html lang="en">
<head>
     <meta charset="utf-8" />
     <meta name="viewport" content="width=device-width, initial-scale=1.0" />
     <title>@ViewData["Title"]</title>
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="container">
            <div class="nav-wrapper">
                <h1 class="logo">🔋 Hệ Thống Thuê Xe Điện</h1>
                <nav class="nav">
                    <a href="/Renter/Index" class="nav-link active">Trang Chủ</a>
                    <a href="/Renter/MyTrips" class="nav-link">Chuyến Đi Của Tôi</a>
                    <a href="#" class="nav-link">Trạm Xe</a>
                    <a href="#" class="nav-link">Hồ Sơ</a>
                    <a href="/Account/Logout" class="nav-link">Đăng Xuất</a>
                </nav>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <h2 class="hero-title">Tìm Xe Điện Hoàn Hảo Của Bạn</h2>
            <p class="hero-subtitle">Chọn, thuê và lái xe điện từ các trạm gần bạn</p>
            <button class="btn-primary" onclick="document.getElementById('vehicles-section').scrollIntoView({behavior: 'smooth'})">Tìm Xe Ngay</button>
        </div>
    </section>

    <!-- Check in Vehicles Section -->
    <section id="checkin-section" class="checkin-section">
        <div class="container">
            <h2>Check-in xe</h2>

            <div class="vehicle-info">
                <h3>Thông tin xe</h3>
                <p><strong>Khách thuê:</strong> @Model.Billing?.RenterId</p>
                <p><strong>Tên xe:</strong> @Model.Billing?.VehicleId</p>
                <p><strong>Ngày thuê:</strong> @Model.Billing?.StartTime</p>
                <p><strong>Dự kiến trả:</strong> @Model.Billing?.ExpectedEndTime</p>
                <p><strong>Giá tiền:</strong> @Model.Billing?.BasePrice.ToString("NO") VNĐ</p>
            </div>

            <div class="input-section">
                <h3>Thông tin trả xe</h3>
                <label>Giờ trả thực tế </label>
                <input type="datetime-local" id="actualEndTime" class="input-control"/>

                <label>Phí trả chậm</label>
                <input type="number" id="lateFee" class="input-control" placeholder="Nhập phí trả chậm nếu có" />

                <label>Phụ phí</label>
                <input type="number" id="extraFee" class="input-control" placeholder="Nhập phụ phí nếu có" />

                <label>Phí hư hỏng</label>
                <input type="number" id="damageCost class="input-control" placeholder="Nhập phí hư hỏng nếu có" />

                <label>Giảm giá</label>
                <input type="number" id="discount" class="input-control" placeholder="Nhập giảm giá nếu có" />

                <hr/>

                <div class="mb-3">
                    <label class="form-label"><b>Tổng giá</b></label>
                    <input type="text" id="totalPrice" class="form-control fw-bold" readonly />
                </div>
            </div>
            <button id="btnCheckIn" class="btn btn-primary mt-3">Xác nhận Check-in</button>

            <div id="result" class="mt-3"></div>
        </div>
    </section>

        @section Script {
        <script>
            document.getElementById('btnCheckIn').addEventListener('click', async () => {
            const dto = {
                rentalRecordId: @Model.RentalRecordId,
                actualReturnTime: document.getElementById('actualTime').value,
                extraFees: parseFloat(document.getElementById('extraFees').value),
                discount: parseFloat(document.getElementById('discount').value),
                hasDamage: parseFloat(document.getElementById('damageCost').value) > 0,
                damageDescription: "Damage",
                damageCost: parseFloat(document.getElementById('damageCost').value)
            };

             const res = await fetch('?handler=Process', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dto)
            });
            const result = await res.json();
            document.getElementById('result').innerText = result.message;
            });
        </script>
        }
    
</body>
</html>