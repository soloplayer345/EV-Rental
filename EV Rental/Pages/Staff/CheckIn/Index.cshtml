@page
@model EV_Rental.Pages.Staff.CheckIn.IndexModel
@{
    ViewData["Title"] = "Quản Lý Check-In";
}

<div class="container-fluid mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- DANH SÁCH ĐƠN THUÊ ĐANG HOẠT ĐỘNG -->
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="bi bi-list-check"></i> Danh Sách Đơn Thuê Đang Hoạt Động
            </h3>
        </div>
        <div class="card-body">
            @if (Model.ActiveRentals.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Mã Đơn</th>
                                <th>Khách Thuê</th>
                                <th>Xe</th>
                                <th>Biển Số</th>
                                <th>Trạm Lấy</th>
                                <th>Bắt Đầu</th>
                                <th>Dự Kiến Trả</th>
                                <th>Giá/Giờ</th>
                                <th>Tiền Cọc</th>
                                <th>Trạng Thái</th>
                                <th>Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rental in Model.ActiveRentals)
                            {
                                var isLate = rental.ExpectedEndTime.HasValue && DateTime.Now > rental.ExpectedEndTime.Value;
                                var rowClass = isLate ? "table-warning" : "";
                                
                                <tr class="@rowClass">
                                    <td class="fw-bold">#@rental.Id</td>
                                    <td>
                                        <div>@rental.Renter?.FullName</div>
                                        <small class="text-muted">@rental.Renter?.Email</small>
                                    </td>
                                    <td>
                                        <div>@rental.Vehicle?.Name</div>
                                        <small class="text-muted">@rental.Vehicle?.Brand</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@rental.Vehicle?.PlateNumber</span>
                                    </td>
                                    <td>@rental.PickupStation?.Name</td>
                                    <td>
                                        @if (rental.StartTime.HasValue)
                                        {
                                            <div>@rental.StartTime.Value.ToString("dd/MM/yyyy")</div>
                                            <small class="text-muted">@rental.StartTime.Value.ToString("HH:mm")</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa bắt đầu</span>
                                        }
                                    </td>
                                    <td>
                                        @if (rental.ExpectedEndTime.HasValue)
                                        {
                                            <div>@rental.ExpectedEndTime.Value.ToString("dd/MM/yyyy")</div>
                                            <small class="@(isLate ? "text-danger fw-bold" : "text-muted")">
                                                @rental.ExpectedEndTime.Value.ToString("HH:mm")
                                                @if (isLate)
                                                {
                                                    <i class="bi bi-exclamation-circle"></i>
                                                }
                                            </small>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-primary fw-bold">@rental.BasePrice.ToString("N0") đ</span>
                                    </td>
                                    <td>
                                        <span class="text-success">@rental.DepositFee.ToString("N0") đ</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success">
                                            <i class="bi bi-arrow-repeat"></i> Đang thuê
                                        </span>
                                        @if (isLate)
                                        {
                                            <br />
                                            <span class="badge bg-warning text-dark mt-1">
                                                <i class="bi bi-clock-history"></i> Trễ hạn
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/Staff/CheckIn/Detail/@rental.Id" class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i> Xem Chi Tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                <div class="mt-3">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> 
                        <strong>Tổng số đơn đang hoạt động:</strong> @Model.ActiveRentals.Count đơn
                        @{
                            var lateCount = Model.ActiveRentals.Count(r => r.ExpectedEndTime.HasValue && DateTime.Now > r.ExpectedEndTime.Value);
                        }
                        @if (lateCount > 0)
                        {
                            <span class="text-warning ms-3">
                                <i class="bi bi-exclamation-triangle"></i> 
                                <strong>@lateCount</strong> đơn trễ hạn
                            </span>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">Không có đơn thuê đang hoạt động</h4>
                    <p class="text-muted">Hiện tại không có đơn thuê nào đang trong quá trình sử dụng.</p>
                </div>
            }
        </div>
    </div>
</div>
